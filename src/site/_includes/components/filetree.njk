{% macro menuItem(fileOrFolderName, fileOrFolder, step, currentPath) %}
    {%if fileOrFolder.isNote or fileOrFolder.isFolder%}
        <div class="{% if step > 0 %}filelist folder-contents{% endif %}">
            {%if fileOrFolder.isNote and not fileOrFolder.hide %}
                <div class="notelink {{ 'active-note' if fileOrFolder.permalink === permalink}}">
                    <a data-note-icon="{{fileOrFolder.noteIcon}}" style="text-decoration: none;" class="filename" href="{{fileOrFolder.permalink}}">{{fileOrFolder.name}} </a>
                </div>
            {% elif fileOrFolder.isFolder%}
                <div class="folder inner-folder" data-folder-path="{{currentPath}}">
                    <div class="foldername-wrapper align-icon folder-toggle">
                    <i class="folder-chevron-open" style="display: none;" data-lucide="chevron-down"></i>
                    <i class="folder-chevron-closed" data-lucide="chevron-right"></i>
                    <span class="foldername">{{fileOrFolderName}}</span>
                    </div>
                    {% for fileOrFolderName, child in fileOrFolder %}
                        {{menuItem(fileOrFolderName, child, step+1, (currentPath+"/"+fileOrFolderName))}}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {%endif%}
    {% endmacro %}

    <div id="filetree-root" class="filetree" data-desktop-min="1000">
        <div id="filetree-mobile-navbar" hidden>
            {%include "components/filetreeNavbar.njk"%}
        </div>

        <div id="filetree-overlay" class="fullpage-overlay" hidden></div>

      <div id="filetree-panel" class="filetree-wrapper">
      <nav class="filetree-sidebar">
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
         {% if meta.siteLogoPath %}
         <a href="/" style="text-decoration: none; display: flex; justify-content: center;">
                   <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}">
         </a>
         {% else %}
         <a href="/" style="text-decoration: none; text-align: center;">
                   <h1 style="text-align:center;">{{meta.siteName}}</h1>
         </a>
         {% endif %}
         {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
        {% if settings.dgEnableSearch === true%}
            {% include "components/searchButton.njk" %}
        {%endif%}
         <div class="folder" data-folder-path="__root__" data-open-default="true">
               {%- for fileOrFolderName, fileOrFolder in filetree -%}
                  {{menuItem(fileOrFolderName, fileOrFolder, 0, fileOrFolderName)}}
               {%- endfor -%}
         </div>
      </nav>
      </div>
    </div>

<script>
(function () {
    const DESKTOP_MIN = 1000;
    const root = document.getElementById('filetree-root');
    if (!root) return;

    const mobileNavbar = document.getElementById('filetree-mobile-navbar');
    const panel = document.getElementById('filetree-panel');
    const overlay = document.getElementById('filetree-overlay');
    const menuBtn = document.getElementById('filetree-menu-btn');
    let showFilesMobile = false;

    function isDesktop() {
        return window.innerWidth >= DESKTOP_MIN;
    }

    function syncLayout() {
        const desktop = isDesktop();
        if (mobileNavbar) mobileNavbar.hidden = desktop;
        if (desktop) showFilesMobile = false;
        if (panel) panel.hidden = !(desktop || showFilesMobile);
        if (overlay) overlay.hidden = !(showFilesMobile && !desktop);
    }

    function setFolderOpen(folder, open) {
        folder.dataset.open = open ? 'true' : 'false';
        const toggle = folder.querySelector(':scope > .foldername-wrapper');
        const openIcon = toggle?.querySelector('.folder-chevron-open');
        const closedIcon = toggle?.querySelector('.folder-chevron-closed');
        if (openIcon) openIcon.style.display = open ? '' : 'none';
        if (closedIcon) closedIcon.style.display = open ? 'none' : '';
        folder.querySelectorAll(':scope > .folder-contents').forEach((el) => {
            el.hidden = !open;
        });
        const path = folder.dataset.folderPath;
        if (path && path !== '__root__') {
            try {
                localStorage.setItem('dg-folder:' + path, open ? '1' : '0');
            } catch (_) {}
        }
    }

    function initFolders() {
        root.querySelectorAll('.folder[data-folder-path]').forEach((folder) => {
            const path = folder.dataset.folderPath;
            let open = folder.dataset.openDefault === 'true';
            if (path && path !== '__root__') {
                open = false;
                try {
                    const stored = localStorage.getItem('dg-folder:' + path);
                    if (stored === '1') open = true;
                    else if (stored === '0') open = false;
                } catch (_) {}
            }
            setFolderOpen(folder, open);

            const toggle = folder.querySelector(':scope > .foldername-wrapper.folder-toggle');
            if (toggle) {
                toggle.addEventListener('click', (event) => {
                    event.stopPropagation();
                    setFolderOpen(folder, folder.dataset.open !== 'true');
                    if (window.lucide) {
                        lucide.createIcons({ attrs: { class: ['svg-icon'] } });
                    }
                });
            }
        });
    }

    menuBtn?.addEventListener('click', () => {
        showFilesMobile = !showFilesMobile;
        syncLayout();
    });
    overlay?.addEventListener('click', () => {
        showFilesMobile = false;
        syncLayout();
    });
    window.addEventListener('resize', syncLayout);

    initFolders();
    syncLayout();
})();
</script>
